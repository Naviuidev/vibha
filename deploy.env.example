# Copy to deploy.env and fill MilesWeb SSH details:
#   cp deploy.env.example deploy.env
#
# Same MilesWeb account as yulowear.in — addon domain folder is vibhaajewellery.in
# Host is often the server IP from MilesWeb mPanel → SSH Access

DEPLOY_HOST=YOUR_SERVER_HOST_OR_IP
DEPLOY_USER=YOUR_CPANEL_USERNAME
DEPLOY_PORT=22

# Remote folders — KEEP single quotes so ~ is not expanded on your Mac
REMOTE_WEBSITE='~/vibhaajewellery.in'
REMOTE_ADMIN='~/vibhaajewellery.in/admin'
REMOTE_API='~/vibhaajewellery.in/backend'
